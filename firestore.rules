rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isInstructor() {
      return signedIn()
        && userExists(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.instructorApprovedAt is timestamp;
    }

    function isCourseOwner(courseId) {
      return isInstructor()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;
    }

    function isEnrollmentStudent() {
      return signedIn() && resource.data.studentId == request.auth.uid;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    // Profiles: public role assignment is intentionally disabled. New accounts
    // may create a student profile; instructor privileges require trusted
    // provisioning until an instructor approval flow is implemented.
    match /users/{userId} {
      allow get: if ownsUser(userId);
      allow list: if false;

      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt is string;

      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatar', 'bio', 'updatedAt'])
        && (!('name' in request.resource.data) ||
          (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120))
        && (!('avatar' in request.resource.data) ||
          (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 2048))
        && (!('bio' in request.resource.data) ||
          (request.resource.data.bio is string && request.resource.data.bio.size() <= 2000))
        && (!('updatedAt' in request.resource.data) ||
          request.resource.data.updatedAt is timestamp);

      allow delete: if false;
    }

    // Course documents contain catalogue metadata only. Lesson payloads live
    // in course_contents and are returned through the access-checked callable.
    match /courses/{courseId} {
      allow read: if signedIn();

      allow create: if isInstructor()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'price', 'category',
          'instructorId', 'instructorName', 'students', 'rating',
          'thumbnail', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'description', 'price', 'category',
          'instructorId', 'instructorName', 'students', 'rating',
          'thumbnail', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 12000
        && request.resource.data.category is string
        && request.resource.data.students == 0
        && request.resource.data.rating == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isCourseOwner(courseId)
        && request.resource.data.instructorId == resource.data.instructorId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description', 'price', 'category', 'thumbnail', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isCourseOwner(courseId);
    }

    // Protected lesson documents must never be read or modified by browser clients.
    // Cloud Functions use the Admin SDK after checking the caller's access.
    match /course_contents/{courseId} {
      allow read, write: if false;
    }

    // Enrollment writes are server-only until the trusted enrollment callable
    // is implemented in Phase 3. This blocks self-issued or forged enrollment.
    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        isCourseOwner(resource.data.courseId)
      );
      allow create, update, delete: if false;
    }

    // Payments are server-managed. Admin SDK callables bypass these rules;
    // browser clients cannot forge intents, verification results, or entitlements.
    match /payments/{paymentId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'members', 'lastMessage', 'lastMessageAt', 'createdAt'])
        && request.resource.data.keys().hasAll(['memberIds', 'members', 'lastMessage', 'lastMessageAt', 'createdAt'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds[0] != request.resource.data.memberIds[1]
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasAll(request.resource.data.memberIds)
        && request.resource.data.members.keys().hasOnly(request.resource.data.memberIds)
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.createdAt is timestamp;

      // Keep membership and member metadata immutable from the client.
      // Client messaging currently updates only the preview fields here.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt is timestamp;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // Cohorts, cohort memberships, broadcasts, and other not-yet-reviewed
    // collections are denied by default until their authorization contracts
    // are implemented. The default deny at the end also covers unknown paths.
  }
}